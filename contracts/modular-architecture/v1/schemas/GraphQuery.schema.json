{
  "additionalProperties": false,
  "description": "Read only published bounded graph scopes; a query never launches a capture.",
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor"
    },
    "identity_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Identity Hash",
      "type": "string"
    },
    "limit": {
      "default": 256,
      "maximum": 256,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "mode": {
      "enum": [
        "train",
        "eval"
      ],
      "title": "Mode",
      "type": "string"
    },
    "scope": {
      "default": "root",
      "maxLength": 512,
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "signature": {
      "enum": [
        "full_prefix",
        "prefill",
        "decode"
      ],
      "title": "Signature",
      "type": "string"
    },
    "view": {
      "enum": [
        "architecture",
        "operations"
      ],
      "title": "View",
      "type": "string"
    }
  },
  "required": [
    "identity_hash",
    "view",
    "mode",
    "signature"
  ],
  "title": "GraphQuery",
  "type": "object"
}
