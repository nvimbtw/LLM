{
  "additionalProperties": false,
  "description": "Bind opaque cursor contents to immutable graph identity, mode, view and scope.",
  "properties": {
    "graph_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Graph Hash",
      "type": "string"
    },
    "identity_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Identity Hash",
      "type": "string"
    },
    "mode": {
      "enum": [
        "train",
        "eval"
      ],
      "title": "Mode",
      "type": "string"
    },
    "offset": {
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "scope": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "signature": {
      "enum": [
        "full_prefix",
        "prefill",
        "decode"
      ],
      "title": "Signature",
      "type": "string"
    },
    "view": {
      "enum": [
        "architecture",
        "operations"
      ],
      "title": "View",
      "type": "string"
    }
  },
  "required": [
    "graph_hash",
    "identity_hash",
    "view",
    "mode",
    "signature",
    "scope",
    "offset"
  ],
  "title": "GraphCursor",
  "type": "object"
}
