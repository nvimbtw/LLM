{
  "$defs": {
    "BlockDeclaration": {
      "additionalProperties": false,
      "description": "Expose declaration metadata before any constructor/profile inputs are available.",
      "properties": {
        "capabilities": {
          "default": [],
          "items": {
            "enum": [
              "cache",
              "introspection",
              "attention",
              "context_extension",
              "recompute",
              "token_rows"
            ],
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "inputs": {
          "maxProperties": 32,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "$ref": "#/$defs/TensorPort"
            }
          },
          "title": "Inputs",
          "type": "object"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "outputs": {
          "maxProperties": 32,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "$ref": "#/$defs/TensorPort"
            }
          },
          "title": "Outputs",
          "type": "object"
        },
        "parameters": {
          "maxProperties": 64,
          "patternProperties": {
            "^[a-z][a-z0-9_]{0,63}$": {
              "$ref": "#/$defs/ParameterDeclaration"
            }
          },
          "title": "Parameters",
          "type": "object"
        },
        "sdk_version": {
          "const": 1,
          "title": "Sdk Version",
          "type": "integer"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "sdk_version",
        "name",
        "title",
        "parameters",
        "inputs",
        "outputs"
      ],
      "title": "BlockDeclaration",
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "description": "Report optional supported behavior only when required profile evidence exists.",
      "properties": {
        "evidence_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Hash"
        },
        "name": {
          "enum": [
            "cache",
            "introspection",
            "attention",
            "context_extension",
            "recompute",
            "token_rows"
          ],
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "supported": {
          "title": "Supported",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "supported"
      ],
      "title": "Capability",
      "type": "object"
    },
    "ParameterDeclaration": {
      "additionalProperties": false,
      "description": "Declare constructor value types, defaults and editor bounds without executing code.",
      "properties": {
        "choices": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "maxLength": 4096,
                "type": "string"
              }
            ]
          },
          "maxItems": 64,
          "title": "Choices",
          "type": "array"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "title": {
          "default": "",
          "maxLength": 120,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "enum": [
            "integer",
            "number",
            "boolean",
            "string",
            "enum"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ParameterDeclaration",
      "type": "object"
    },
    "ResourceSummary": {
      "additionalProperties": false,
      "description": "List bounded catalog metadata without embedding administrative source or graphs.",
      "properties": {
        "accepted_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "archived": {
          "title": "Archived",
          "type": "boolean"
        },
        "capabilities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "maxItems": 6,
          "title": "Capabilities",
          "type": "array"
        },
        "description": {
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "draft_version": {
          "minimum": 1,
          "title": "Draft Version",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "block",
            "architecture"
          ],
          "title": "Kind",
          "type": "string"
        },
        "metadata_version": {
          "minimum": 1,
          "title": "Metadata Version",
          "type": "integer"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "origin": {
          "enum": [
            "builtin",
            "custom"
          ],
          "title": "Origin",
          "type": "string"
        },
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "kind",
        "name",
        "description",
        "origin",
        "archived",
        "metadata_version",
        "draft_version",
        "accepted_revision"
      ],
      "title": "ResourceSummary",
      "type": "object"
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "Pin immutable bytes separately from their resource's editable display identity.",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "kind": {
          "enum": [
            "block",
            "architecture"
          ],
          "title": "Kind",
          "type": "string"
        },
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "resource_id",
        "revision_id",
        "content_hash"
      ],
      "title": "RevisionRef",
      "type": "object"
    },
    "TensorPort": {
      "additionalProperties": false,
      "description": "Declare tensor rank, dtype family and resolved or named dimension constraints.",
      "properties": {
        "dtype": {
          "enum": [
            "int64",
            "int32",
            "bool",
            "floating",
            "float32",
            "float16",
            "bfloat16"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "shape": {
          "items": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                "type": "string"
              }
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "dtype",
        "shape"
      ],
      "title": "TensorPort",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Expose catalog metadata and known declarations without loading editable source.",
  "properties": {
    "declaration": {
      "anyOf": [
        {
          "$ref": "#/$defs/BlockDeclaration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parameters": {
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,63}$": {
          "$ref": "#/$defs/ParameterDeclaration"
        }
      },
      "title": "Parameters",
      "type": "object"
    },
    "revision_count": {
      "minimum": 0,
      "title": "Revision Count",
      "type": "integer"
    },
    "summary": {
      "$ref": "#/$defs/ResourceSummary"
    }
  },
  "required": [
    "summary",
    "revision_count"
  ],
  "title": "ResourceDetail",
  "type": "object"
}
