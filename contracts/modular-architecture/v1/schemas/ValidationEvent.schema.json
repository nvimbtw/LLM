{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "description": "Return bounded actionable failures without tensor values, arbitrary objects or raw logs.",
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "instance_path": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Path"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "phase": {
          "enum": [
            "save",
            "inspection",
            "resolution",
            "construction",
            "capture",
            "numerical",
            "admission",
            "execution",
            "publication"
          ],
          "title": "Phase",
          "type": "string"
        },
        "resource_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Id"
        },
        "revision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Id"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "yaml_path": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yaml Path"
        }
      },
      "required": [
        "code",
        "message",
        "phase"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "description": "Locate packaged source by immutable revision and relative file, not private host paths.",
      "properties": {
        "column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "file": {
          "maxLength": 512,
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        }
      },
      "required": [
        "revision_id",
        "file"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "StageOutcome": {
      "additionalProperties": false,
      "description": "Report finite validation stages independently of execution lifecycle status.",
      "properties": {
        "elapsed_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Ms"
        },
        "outcome": {
          "enum": [
            "pending",
            "running",
            "passed",
            "failed",
            "skipped"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "stage": {
          "enum": [
            "inspection",
            "resolution",
            "construction",
            "capture",
            "numerical",
            "admission",
            "publication"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "outcome"
      ],
      "title": "StageOutcome",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Extend existing job events with bounded validation stages and terminal REST reconciliation.",
  "properties": {
    "diagnostic": {
      "anyOf": [
        {
          "$ref": "#/$defs/Diagnostic"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "stage": {
      "anyOf": [
        {
          "$ref": "#/$defs/StageOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "type": {
      "enum": [
        "validation_stage",
        "done",
        "error",
        "cancelled"
      ],
      "title": "Type",
      "type": "string"
    },
    "verdict": {
      "anyOf": [
        {
          "enum": [
            "inspection_only",
            "invalid",
            "valid",
            "provisional"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verdict"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "type"
  ],
  "title": "ValidationEvent",
  "type": "object"
}
