{
  "$defs": {
    "ArtifactAdopted": {
      "additionalProperties": false,
      "description": "Acknowledge parent verification, publication and durable registration of a staged artifact.",
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "adopted",
            "rejected"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "publication_id": {
          "format": "uuid",
          "title": "Publication Id",
          "type": "string"
        },
        "type": {
          "const": "artifact_adopted",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "publication_id",
        "artifact_id",
        "outcome"
      ],
      "title": "ArtifactAdopted",
      "type": "object"
    },
    "ArtifactReady": {
      "additionalProperties": false,
      "description": "Announce a complete staged artifact; availability waits for parent adoption acknowledgement.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/RuntimeArtifact"
        },
        "completed_step": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Completed Step",
          "type": "integer"
        },
        "final": {
          "title": "Final",
          "type": "boolean"
        },
        "publication_id": {
          "format": "uuid",
          "title": "Publication Id",
          "type": "string"
        },
        "type": {
          "const": "artifact_ready",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "publication_id",
        "artifact",
        "completed_step",
        "final"
      ],
      "title": "ArtifactReady",
      "type": "object"
    },
    "Cancel": {
      "additionalProperties": false,
      "description": "Cooperatively cancel a request; this acknowledgement cannot release admission.",
      "properties": {
        "reason": {
          "enum": [
            "user",
            "disconnect",
            "deadline",
            "shutdown",
            "resource_limit"
          ],
          "title": "Reason",
          "type": "string"
        },
        "target_request_id": {
          "format": "uuid",
          "title": "Target Request Id",
          "type": "string"
        },
        "type": {
          "const": "cancel",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "target_request_id",
        "reason"
      ],
      "title": "Cancel",
      "type": "object"
    },
    "CleanupVerified": {
      "additionalProperties": false,
      "description": "Guardian-only tree cleanup certificate, bound to the engine's current lease identity.",
      "properties": {
        "lease_id": {
          "format": "uuid",
          "title": "Lease Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "reaped",
            "uncertain"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "owned_processes_remaining": {
          "maximum": 8,
          "minimum": 0,
          "title": "Owned Processes Remaining",
          "type": "integer"
        },
        "type": {
          "const": "cleanup_verified",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "lease_id",
        "outcome",
        "owned_processes_remaining"
      ],
      "title": "CleanupVerified",
      "type": "object"
    },
    "Completed": {
      "additionalProperties": false,
      "description": "Finish one operation, retaining any reusable serving model until explicit eviction.",
      "properties": {
        "outcome": {
          "enum": [
            "ok",
            "cancelled"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "completed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "outcome"
      ],
      "title": "Completed",
      "type": "object"
    },
    "DatasetReadEffect": {
      "additionalProperties": false,
      "description": "Read dataset metadata/pages through Rust using a dataset UUID and bounded query data.",
      "properties": {
        "dataset_id": {
          "format": "uuid",
          "title": "Dataset Id",
          "type": "string"
        },
        "operation": {
          "const": "dataset_read",
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "operation",
        "dataset_id"
      ],
      "title": "DatasetReadEffect",
      "type": "object"
    },
    "EffectData": {
      "additionalProperties": false,
      "description": "A versioned effect payload interpreted by its specific actor-bound parent adapter.",
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "format": {
          "const": "effect_data_v1",
          "title": "Format",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "size_bytes",
        "format"
      ],
      "title": "EffectData",
      "type": "object"
    },
    "EffectReply": {
      "additionalProperties": false,
      "description": "Return an issued operation's outcome; uncertain writes are terminal and never replayed.",
      "properties": {
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "uncertain"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "effect_reply",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "operation_id",
        "outcome"
      ],
      "title": "EffectReply",
      "type": "object"
    },
    "EffectRequest": {
      "additionalProperties": false,
      "description": "Request a parent-mediated Rust effect with exact operation-specific resource identity.",
      "properties": {
        "effect": {
          "discriminator": {
            "mapping": {
              "dataset_read": "#/$defs/DatasetReadEffect",
              "gym_abandon": "#/$defs/GymAbandonEffect",
              "gym_catalogue": "#/$defs/GymCatalogueEffect",
              "gym_create": "#/$defs/GymCreateEffect",
              "gym_finish": "#/$defs/GymFinishEffect",
              "gym_read": "#/$defs/GymReadEffect",
              "gym_status": "#/$defs/GymStatusEffect",
              "gym_step": "#/$defs/GymStepEffect"
            },
            "propertyName": "operation"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DatasetReadEffect"
            },
            {
              "$ref": "#/$defs/GymCatalogueEffect"
            },
            {
              "$ref": "#/$defs/GymCreateEffect"
            },
            {
              "$ref": "#/$defs/GymReadEffect"
            },
            {
              "$ref": "#/$defs/GymStepEffect"
            },
            {
              "$ref": "#/$defs/GymFinishEffect"
            },
            {
              "$ref": "#/$defs/GymAbandonEffect"
            },
            {
              "$ref": "#/$defs/GymStatusEffect"
            }
          ],
          "title": "Effect"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "type": {
          "const": "effect_request",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "operation_id",
        "effect"
      ],
      "title": "EffectRequest",
      "type": "object"
    },
    "Failed": {
      "additionalProperties": false,
      "description": "Report a bounded classified failure; source diagnostics remain administrator-only.",
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "title": "Message",
          "type": "string"
        },
        "phase": {
          "enum": [
            "inspection",
            "import",
            "construction",
            "load",
            "validation",
            "capture",
            "forward",
            "backward",
            "checkpoint",
            "generation",
            "measurement",
            "cleanup"
          ],
          "title": "Phase",
          "type": "string"
        },
        "type": {
          "const": "failed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "phase",
        "code",
        "message"
      ],
      "title": "Failed",
      "type": "object"
    },
    "Generate": {
      "additionalProperties": false,
      "description": "Generate a bounded request using worker-owned cache, reset at request completion.",
      "properties": {
        "max_tokens": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "pins": {
          "$ref": "#/$defs/RuntimePins"
        },
        "prompt": {
          "$ref": "#/$defs/RuntimeArtifact"
        },
        "seed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "temperature": {
          "maximum": 10,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "type": {
          "const": "generate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "pins",
        "prompt",
        "max_tokens",
        "seed",
        "temperature"
      ],
      "title": "Generate",
      "type": "object"
    },
    "GymAbandonEffect": {
      "additionalProperties": false,
      "description": "Close an unavailable episode without grading it or inventing a zero reward.",
      "properties": {
        "episode_id": {
          "format": "uuid",
          "title": "Episode Id",
          "type": "string"
        },
        "operation": {
          "const": "gym_abandon",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "episode_id"
      ],
      "title": "GymAbandonEffect",
      "type": "object"
    },
    "GymCatalogueEffect": {
      "additionalProperties": false,
      "description": "List authorized gym metadata before resolving a named training lane.",
      "properties": {
        "operation": {
          "const": "gym_catalogue",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "operation"
      ],
      "title": "GymCatalogueEffect",
      "type": "object"
    },
    "GymCreateEffect": {
      "additionalProperties": false,
      "description": "Create an RL run for an opaque gym ID, preserving identifiers such as math/general.",
      "properties": {
        "gym_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Gym Id",
          "type": "string"
        },
        "operation": {
          "const": "gym_create",
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/EffectData"
        }
      },
      "required": [
        "operation",
        "gym_id",
        "payload"
      ],
      "title": "GymCreateEffect",
      "type": "object"
    },
    "GymFinishEffect": {
      "additionalProperties": false,
      "description": "Finish and grade an episode exactly once with an explicit final-reply payload.",
      "properties": {
        "episode_id": {
          "format": "uuid",
          "title": "Episode Id",
          "type": "string"
        },
        "operation": {
          "const": "gym_finish",
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/EffectData"
        }
      },
      "required": [
        "operation",
        "episode_id",
        "payload"
      ],
      "title": "GymFinishEffect",
      "type": "object"
    },
    "GymReadEffect": {
      "additionalProperties": false,
      "description": "Read an authorized gym run by its UUID without exposing service URLs.",
      "properties": {
        "operation": {
          "const": "gym_read",
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "run_id"
      ],
      "title": "GymReadEffect",
      "type": "object"
    },
    "GymStatusEffect": {
      "additionalProperties": false,
      "description": "Update the authorized run status using its UUID and typed status payload.",
      "properties": {
        "operation": {
          "const": "gym_status",
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/EffectData"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "run_id",
        "payload"
      ],
      "title": "GymStatusEffect",
      "type": "object"
    },
    "GymStepEffect": {
      "additionalProperties": false,
      "description": "Issue one episode tool step; the operation identity prevents replay after uncertainty.",
      "properties": {
        "episode_id": {
          "format": "uuid",
          "title": "Episode Id",
          "type": "string"
        },
        "operation": {
          "const": "gym_step",
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/EffectData"
        }
      },
      "required": [
        "operation",
        "episode_id",
        "payload"
      ],
      "title": "GymStepEffect",
      "type": "object"
    },
    "Inspect": {
      "additionalProperties": false,
      "description": "Inspect bounded source declarations without constructing a custom model.",
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/RuntimeArtifact"
        },
        "type": {
          "const": "inspect",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "snapshot"
      ],
      "title": "Inspect",
      "type": "object"
    },
    "Load": {
      "additionalProperties": false,
      "description": "Load one pinned definition/package into the reusable serving worker.",
      "properties": {
        "definition": {
          "$ref": "#/$defs/RuntimeArtifact"
        },
        "package": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pins": {
          "$ref": "#/$defs/RuntimePins"
        },
        "type": {
          "const": "load",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "pins",
        "definition"
      ],
      "title": "Load",
      "type": "object"
    },
    "Measure": {
      "additionalProperties": false,
      "description": "Run one bounded measurement in the model worker under the same admission lease.",
      "properties": {
        "measurement": {
          "$ref": "#/$defs/RuntimeArtifact"
        },
        "pins": {
          "$ref": "#/$defs/RuntimePins"
        },
        "type": {
          "const": "measure",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "pins",
        "measurement"
      ],
      "title": "Measure",
      "type": "object"
    },
    "Progress": {
      "additionalProperties": false,
      "description": "Bounded completed work; actual batch/iteration advancement refreshes training watchdogs.",
      "properties": {
        "completed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Completed",
          "type": "integer"
        },
        "loss": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loss"
        },
        "phase": {
          "enum": [
            "inspection",
            "import",
            "construction",
            "load",
            "validation",
            "capture",
            "forward",
            "backward",
            "checkpoint",
            "generation",
            "measurement",
            "cleanup"
          ],
          "title": "Phase",
          "type": "string"
        },
        "total": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "type": {
          "const": "progress",
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "enum": [
            "bytes",
            "nodes",
            "batches",
            "steps",
            "iterations",
            "tokens",
            "phases"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "type",
        "phase",
        "completed",
        "unit"
      ],
      "title": "Progress",
      "type": "object"
    },
    "RuntimeArtifact": {
      "additionalProperties": false,
      "description": "Immutable bounded materialization grant; the parent resolves IDs, never worker paths.",
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "format": {
          "enum": [
            "source_snapshot_v1",
            "validation_snapshot_v1",
            "definition_v1",
            "model_package_v1",
            "training_config_v1",
            "corpus_v1",
            "tokenizer_v1",
            "span_table_v1",
            "loss_mask_v1",
            "sft_probe_v1",
            "prompt_v1",
            "measurement_v1",
            "effect_data_v1",
            "validation_result_v1",
            "training_result_v1",
            "training_progress_v1",
            "generation_result_v1",
            "measurement_result_v1",
            "checkpoint_v1"
          ],
          "title": "Format",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "size_bytes",
        "format"
      ],
      "title": "RuntimeArtifact",
      "type": "object"
    },
    "RuntimePins": {
      "additionalProperties": false,
      "description": "Exact semantic definition, binding, execution-profile and valid-receipt identity.",
      "properties": {
        "bindings_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bindings Digest",
          "type": "string"
        },
        "definition_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Definition Id",
          "type": "string"
        },
        "profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Digest",
          "type": "string"
        },
        "receipt_id": {
          "format": "uuid",
          "title": "Receipt Id",
          "type": "string"
        }
      },
      "required": [
        "definition_id",
        "bindings_digest",
        "profile_digest",
        "receipt_id"
      ],
      "title": "RuntimePins",
      "type": "object"
    },
    "Shutdown": {
      "additionalProperties": false,
      "description": "Evict resident model state and close the worker after guardian-verified cleanup.",
      "properties": {
        "reason": {
          "enum": [
            "eviction",
            "shutdown",
            "idle",
            "quarantine"
          ],
          "title": "Reason",
          "type": "string"
        },
        "type": {
          "const": "shutdown",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "title": "Shutdown",
      "type": "object"
    },
    "Tokens": {
      "additionalProperties": false,
      "description": "A bounded streaming chunk; transcript storage remains in the Rust backend.",
      "properties": {
        "log_probabilities": {
          "anyOf": [
            {
              "items": {
                "maximum": 0,
                "type": "number"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Probabilities"
        },
        "token_ids": {
          "items": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Token Ids",
          "type": "array"
        },
        "type": {
          "const": "tokens",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "token_ids"
      ],
      "title": "Tokens",
      "type": "object"
    },
    "Train": {
      "additionalProperties": false,
      "description": "Run the complete pretrain/SFT/RL lifecycle with resident model and optimizer state.",
      "properties": {
        "config": {
          "$ref": "#/$defs/RuntimeArtifact"
        },
        "corpus": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "pins": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimePins"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "training_kind": {
          "enum": [
            "pretrain",
            "sft",
            "rl"
          ],
          "title": "Training Kind",
          "type": "string"
