# Copy to `.env` — Compose reads that file automatically — and fill in the
# secrets. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#   for k in JWT_SECRET ENGINE_SERVICE_SECRET DATA_ENGINE_SERVICE_SECRET \
#            BACKEND_SERVICE_SECRET SEARXNG_SECRET; do
#       printf '%s=%s\n' "$k" "$(openssl rand -hex 32)"
#   done >> .env
#
# The four service secrets are required rather than optional, and
# docker-compose.yml refuses to start without them. Unset, they leave the
# service hops and /internal unauthenticated — which is a bargain the native
# setup can strike because it binds loopback, and a container cannot, because a
# published port cannot reach a loopback binding.

JWT_SECRET=
ENGINE_SERVICE_SECRET=
DATA_ENGINE_SERVICE_SECRET=
BACKEND_SERVICE_SECRET=
SEARXNG_SECRET=

# Postgres. The port is 5433 on the host because a development machine usually
# already has a server on 5432; inside the compose network it is always 5432.
POSTGRES_USER=slate
POSTGRES_PASSWORD=slate
POSTGRES_PORT=5433

# Bind mounts do not deliver inotify events on macOS or Windows, so the Next.js
# dev server polls to notice an edit. Set false on Linux to save the idle CPU.
WATCHPACK_POLLING=true
