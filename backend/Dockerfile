# syntax=docker/dockerfile:1

# Every stage builds with SQLX_OFFLINE. The query macros check each query
# against a live schema at *compile* time and a build stage has no route to the
# `postgres` service, so `.sqlx/` — checked in, generated by
# `cargo sqlx prepare --workspace` — stands in for one. Regenerate it whenever a
# query or a migration changes, or the build here fails while `cargo run` on the
# host still succeeds.

FROM rust:1.96-slim-bookworm AS base
# aws-lc-sys and ring compile C sources; cmake and perl are aws-lc's own build
# dependencies, not ours. Nothing here needs OpenSSL — reqwest is on rustls and
# sqlx is compiled without a TLS feature at all.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake perl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV SQLX_OFFLINE=true

# The compose default. Source arrives as a bind mount and `target/` is a named
# volume, so a rebuild resumes from the last one instead of starting cold — and
# never touches the host's `target/`, whose artifacts are for a different libc.
FROM base AS dev
RUN cargo install cargo-watch --locked
# `-w` is explicit because the bind mount also carries `target/`, and watching
# the directory cargo writes into is a rebuild loop that never settles.
CMD ["cargo", "watch", "-w", "src", "-w", "crates", "-w", "Cargo.toml", "-x", "run"]

FROM base AS build
COPY . .
RUN cargo build --release

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/target/release/backend /usr/local/bin/backend
CMD ["backend"]
