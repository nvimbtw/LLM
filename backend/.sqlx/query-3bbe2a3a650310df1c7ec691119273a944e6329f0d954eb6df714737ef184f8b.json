  "query": "INSERT INTO chats(owner_id, title, project_id)\n           SELECT $1, $2, $3::uuid\n           WHERE $3::uuid IS NULL OR EXISTS (SELECT 1 FROM projects WHERE id = $3 AND owner_id = $1)\n           RETURNING id, title, project_id, created_at, 0::bigint AS \"tokens!\"",
