{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.name, p.description, p.notes, p.created_at, p.updated_at,\n                  count(c.id) AS \"thread_count!\"\n           FROM projects p LEFT JOIN chats c ON c.project_id = p.id AND c.owner_id = p.owner_id\n           WHERE p.owner_id = $1 AND p.id = $2 GROUP BY p.id",
