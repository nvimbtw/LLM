  "query": "SELECT a.id,a.message_id,a.filename,a.media_type,a.size,a.created_at FROM attachments a JOIN messages m ON m.id=a.message_id JOIN chats c ON c.id=m.chat_id WHERE c.id=$1 AND c.owner_id=$2 AND a.owner_id=$2 ORDER BY a.created_at,a.id",
