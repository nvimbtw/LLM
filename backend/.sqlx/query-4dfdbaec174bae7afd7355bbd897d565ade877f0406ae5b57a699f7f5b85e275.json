{
  "db_name": "PostgreSQL",
  "query": "SELECT c.id,c.title,c.project_id,c.created_at,COALESCE(t.tokens,0)::bigint AS \"tokens!\" FROM (SELECT id,title,project_id,created_at FROM chats WHERE owner_id=$1 ORDER BY created_at DESC LIMIT $2) c LEFT JOIN LATERAL (SELECT sum(tokens) AS tokens FROM messages WHERE chat_id=c.id) t ON true ORDER BY c.created_at DESC",
