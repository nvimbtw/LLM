{
  "db_name": "PostgreSQL",
  "query": "SELECT c.id, c.title, c.project_id, c.created_at, COALESCE(sum(m.tokens), 0)::bigint AS \"tokens!\"\n           FROM chats c LEFT JOIN messages m ON m.chat_id = c.id\n           WHERE c.owner_id = $1 AND c.project_id = $2 GROUP BY c.id\n           ORDER BY c.created_at DESC, c.id LIMIT $3 OFFSET $4",
