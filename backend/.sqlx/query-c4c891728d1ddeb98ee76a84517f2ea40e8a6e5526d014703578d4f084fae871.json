{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.name, p.description, p.notes, p.created_at, p.updated_at,\n                  (SELECT count(*) FROM chats WHERE project_id = p.id AND owner_id = $1) AS \"thread_count!\"\n           FROM chats c JOIN projects p ON p.id = c.project_id AND p.owner_id = c.owner_id\n           WHERE c.owner_id = $1 AND c.id = $2",
