# PG-19 dataset — downloaded backup, regenerated via download_pg19.py (not versioned)
/pg19/
/pg19_raw/

# Rust build artifacts — never version compiler output
target/

# Compiled CUDA shader artifacts — regenerated by build.rs via nvcc
backend/crates/llm/src/training/shaders/*.o
backend/crates/llm/src/training/shaders/*.a

# Python bytecode caches
__pycache__/

# The engine's virtualenv — 5 GB of wheels, rebuilt from requirements.
engine/.venv/

# The engine owns the corpora, models and datasets. They arrive via the fetch
# scripts and are regenerated, not versioned. This also covers what a fetch
# leaves beside them: .prepare_state.json and .prepare_logs/ from prepare_all.py.
engine/data/

# Datasets a fetch script stages inside the repo. prepare_smoltalk.py's
# --cache-dir defaults here and snapshot_download()s the whole source repo into
# it — gigabytes, one `git add .` away from the history.
/.cache/

# Local secrets and connection strings.
.env

# Scratch evaluations and backups that live in the working tree but are not
# part of the project. Listed so a `git add -A` cannot sweep them into a commit.
/continuous-thinking-evaluation.html
/mcp-evaluation.html
*.bak

# SearXNG writes its cache here, and takes ownership of config/ on start.
deploy/searxng/data/
